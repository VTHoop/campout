# Copy to .env.local and fill in. ⛔ NEVER commit .env.local (ADR-0010).
# A committed secret is ROTATED, not deleted — git history keeps what you pushed.

# ---- Supabase (ADR-0002) ----
# Browser-safe. Anon key reads are still governed by RLS (ADR-0004).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⛔ SERVICE ROLE — bypasses every RLS policy.
# Migrations and local seed scripts ONLY. Never in application code, never in a
# browser bundle, never in a runtime that serves user requests (AGENTS.md §1).
SUPABASE_SERVICE_ROLE_KEY=

# ---- Maps (ADR-0007) ----
# MapLibre renders; the tile provider is swappable behind this one value.
NEXT_PUBLIC_MAPTILER_KEY=

# ---- Quality gates (AGENTS.md §1) ----
# Free personal token: https://codescene.io/users/me/pat
CS_ACCESS_TOKEN=
